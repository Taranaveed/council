GROQ_API_KEY=your_groq_key
# Optional: primary + fallback when the 70B daily token cap is hit
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_EXPIRE_HOURS=72
MARKET_SERVICE_URL=http://localhost:3001

# Production (Render): your Vercel site URL, no trailing slash
# FRONTEND_ORIGIN=https://your-app.vercel.app
# Or comma-separated list:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app

# Global region defaults (do NOT hardcode Pakistan for worldwide launches)
# DEFAULT_REGION: us | eu | uk | asia | pk
DEFAULT_REGION=us
DEFAULT_COUNTRY_CODE=us
DEFAULT_LOCATION=United States
DEFAULT_LANGUAGE=en
