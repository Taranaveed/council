GROQ_API_KEY=your_groq_key
# Optional: primary + fallback if the primary is missing or rate-limited
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_EXPIRE_HOURS=72
MARKET_SERVICE_URL=http://localhost:3001

# Production (Render): your Vercel site URL, no trailing slash — required for CORS
# FRONTEND_ORIGIN=https://project-nsy5u.vercel.app
# Or comma-separated list (include preview URLs you actually use):
# CORS_ORIGINS=https://project-nsy5u.vercel.app

# Global region defaults — Phase 1 deploy default is UK.
# Pakistan (pk / region_pk_v1) remains the golden regression fixture; Shopping stays off for pk.
# DEFAULT_REGION: us | eu | uk | asia | pk
DEFAULT_REGION=uk
DEFAULT_COUNTRY_CODE=uk
DEFAULT_LOCATION=United Kingdom
DEFAULT_LANGUAGE=en

# --- Alerts & Automation ---
# Background poller (default on). Set ALERTS_SCHEDULER=0 to disable.
# ALERTS_SCHEDULER=1
# ALERTS_POLL_SECONDS=900
# Required for POST /api/workspace/alerts/cron from an external scheduler:
# ALERTS_CRON_SECRET=replace-with-a-long-random-secret
# ALERT_STALE_HOURS=12
# ALERT_DROP_PCT=0.05
# ALERT_COOLDOWN_DAYS=3
# MAX_WATCHES_PER_USER=10
# WATCH_CACHE_TTL_HOURS=6
# Email is OFF by default. It requires explicit enablement plus sender setup.
# ALERT_EMAIL_ENABLED=0
# ALERT_EMAIL_DAILY_CAP=3
# PUBLIC_API_ORIGIN=https://api.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Council <alerts@example.com>
# SMTP_TLS=1
# EMAIL_BOUNCE_SECRET=replace-with-a-long-random-secret
