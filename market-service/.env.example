# Required for live Google Shopping listings:
# https://serpapi.com/manage-api-key
# UUID-shaped values are almost never valid SerpApi keys.
SERPAPI_KEY=c670b617ba571c8ba3993f672e1eee69556dd9a361575aab38dbd38675914bc1
PORT=3001

# Global region defaults — change these per deployment region
# Examples:
#   US launch:  DEFAULT_REGION=us  DEFAULT_COUNTRY_CODE=us  DEFAULT_LOCATION=United States
#   EU launch:  DEFAULT_REGION=eu  DEFAULT_COUNTRY_CODE=de  DEFAULT_LOCATION=Berlin, Germany
#   UK launch:  DEFAULT_REGION=uk  DEFAULT_COUNTRY_CODE=uk  DEFAULT_LOCATION=London, United Kingdom
#   PK launch:  DEFAULT_REGION=pk  DEFAULT_COUNTRY_CODE=pk  DEFAULT_LOCATION=Lahore, Pakistan
DEFAULT_REGION=us
DEFAULT_COUNTRY_CODE=us
DEFAULT_LOCATION=United States
DEFAULT_LANGUAGE=en
